# ── EvidentialAI Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# NVIDIA NIM API Key — get yours at https://build.nvidia.com
# Paste your key below (starts with nvapi-)
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# Optional: override default models (leave blank to use defaults)
# NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
# NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
# NVIDIA_REASONING_MODEL=meta/llama-3.2-90b-vision-instruct
# NVIDIA_GRAPH_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# ── Windows space-in-path fix (if your USERPROFILE has spaces) ──
# EVIDENTAI_RUNTIME_DIR=C:\tmp\evidentai
# HF_HOME=C:\tmp\hf_cache
# HUGGINGFACE_HUB_CACHE=C:\tmp\hf_cache\hub
# TRANSFORMERS_CACHE=C:\tmp\hf_cache\transformers
# TORCH_HOME=C:\tmp\torch_cache
# DOCLING_ARTIFACTS_PATH=C:\tmp\docling_artifacts
# EASYOCR_MODULE_PATH=C:\tmp\easyocr_cache
# XDG_CACHE_HOME=C:\tmp\xdg_cache
